{
  "name": "crap-detector",
  "version": "0.1.0",
  "description": "Detection deterministe de la degradation de code TypeScript : metriques AST, hotspots, duplication, code mort, cycles, baseline/ratchet.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugoblanc/crap-detector.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "crap-detector": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
